# Hearth Configuration
# Copy to .env and customize

# Server
HEARTH_HOST=0.0.0.0
HEARTH_PORT=8090
HEARTH_DEBUG=false

# Security - MUST be set! Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HEARTH_SECRET_KEY=
HEARTH_SESSION_EXPIRE_HOURS=72

# CORS - 逗号分隔的允许域名，生产环境改为实际域名
HEARTH_CORS_ORIGINS=http://localhost:3000,http://localhost:8090

# Database
HEARTH_DB_PATH=data/hearth.db

# Backup
HEARTH_BACKUP_DIR=backups
HEARTH_BACKUP_CRON=0 3 * * *
HEARTH_BACKUP_RETENTION=7

# WeChat Bot (optional)
HEARTH_WECHAT_BOT_KEY=
HEARTH_WECHAT_BOT_ENABLED=false

# Upload
HEARTH_UPLOAD_DIR=data/uploads
HEARTH_UPLOAD_MAX_SIZE_MB=10

# Rate Limit
HEARTH_RATE_LIMIT_ENABLED=true
HEARTH_RATE_LIMIT_LOGIN=5/minute
HEARTH_RATE_LIMIT_REGISTER=3/minute
